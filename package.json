{
  "name": "relicspire",
  "version": "1.0.0",
  "description": "タイムラインバトルと自由なリビルドで強敵に挑む思考型ダンジョン RPG です。 3人パーティと8職のスキルツリー、固定性能の遺物を組み合わせ、パズルのように神の試練を攻略します。",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Relicspire/Relicspire.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Relicspire/Relicspire/issues"
  },
  "homepage": "https://github.com/Relicspire/Relicspire#readme",
  "private": true,
  "engines": {
    "node": ">=24.13.0 <25"
  },
  "dependencies": {
    "idb-keyval": "^6.3.0",
    "pixi.js": "^8.22.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.5",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
